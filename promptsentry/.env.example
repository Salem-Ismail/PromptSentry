POSTGRES_USER=promptsentry
POSTGRES_PASSWORD=promptsentry
POSTGRES_DB=promptsentry

# docker hostname is "postgres"
DATABASE_URL=postgresql://promptsentry:promptsentry@postgres:5432/promptsentry

PGADMIN_DEFAULT_EMAIL=admin@promptsentry.dev
PGADMIN_DEFAULT_PASSWORD=admin

OPENAI_API_KEY=sk-your-key-here
OPENAI_BASE_URL=https://api.openai.com

# clients use these, not the openai key. comma separated
PROMPTSENTRY_API_KEYS=ps_dev_key_change_me

REDIS_URL=redis://redis:6379/0
RATE_LIMIT_PER_MINUTE=20
